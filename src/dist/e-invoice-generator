#!/usr/bin/env bash
# Starts the E-Invoice Generator. The lib directory with the JAR and the libraries must be in the same
# directory as this script. The build replaces the version in the name of the JAR.
# Uses $JAVA_HOME/bin/java if JAVA_HOME is set, otherwise "java" from the PATH (Java 17 or newer).
#
# Usage: e-invoice-generator [--config <directory>] [--help] [--version]

set -euo pipefail

script_dir="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
jar="$script_dir/lib/e-invoice-generator-@project.version@.jar"

if [[ ! -f "$jar" ]]; then
    echo "JAR not found in the lib directory next to this script: $jar" >&2
    exit 1
fi

if [[ -n "${JAVA_HOME:-}" ]]; then
    java="$JAVA_HOME/bin/java"
else
    java="java"
fi

exec "$java" -jar "$jar" "$@"
